# ==== Telegram ====
# Lấy token từ @BotFather trên Telegram (gửi /newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# (Tùy chọn) Chỉ cho phép các Telegram user ID này dùng bot, cách nhau bằng dấu phẩy.
# Để trống = cho phép tất cả mọi người chat với bot.
# Cách lấy ID: nhắn cho @userinfobot trên Telegram.
ALLOWED_TELEGRAM_IDS=

# ==== Claude (Anthropic) ====
# Lấy API key tại https://console.anthropic.com/ -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ==== Google Sheet ====
# ID của Google Sheet (phần giữa /d/ và /edit trong URL)
GOOGLE_SHEET_ID=1rmRs2WQUBxx1nKM4myg-FdiHXM-JLh5PANZ94detklw

# gid của tab cần phân tích (số sau gid= trong URL). Để trống = đọc tab đầu tiên.
GOOGLE_SHEET_GID=269413507

# Đường dẫn tới file JSON của Google Service Account (xem README phần cài đặt)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# (Tùy chọn) Số giây cache dữ liệu sheet để đỡ gọi Google liên tục. Mặc định 120s.
SHEET_CACHE_TTL=120
